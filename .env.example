# iotwong environment placeholders (docs/06-deployment.md).
# Copy to `.env` and fill real values with ./scripts/init-secrets.sh (T07).
# Never commit real secrets; `.env*` is git-ignored except this example.

# --- Application ---
APP_ENV=development
HTTP_PORT=8080
DISPLAY_TIMEZONE=Asia/Shanghai
SESSION_KEY=change-me-32-bytes-minimum

# --- PostgreSQL (external mode: host database, see .env.local) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=iotwong
DB_USER=iotwong_app
DB_PASSWORD=change-me

# Owner/migrate connection (migrations only; never given to app roles)
MIGRATION_DB_HOST=127.0.0.1
MIGRATION_DB_PORT=5432
MIGRATION_DB_NAME=iotwong
MIGRATION_DB_USER=iotwong_owner
MIGRATION_DB_PASSWORD=change-me

# --- MQTT (Eclipse Mosquitto) ---
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=iotwong_ingestor
MQTT_PASSWORD=change-me

# --- Integrations ---
LUATOS_ENABLED=false
# MAP_STYLE_URL=https://example.invalid/style.json   # self-hosted tiles only

# --- Map (A15 domestic basemap; default AMap). Injected at web image build time ---
# 底图供应商：offline(默认，离线灰底) | amap(需合法高德 Web 端 Key，按服务条款使用)
# VITE_MAP_PROVIDER=offline
# VITE_MAP_KEY=<高德开放平台 Web端 Key，仅 provider=amap 时生效>
